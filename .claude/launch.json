{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zaro-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3217,
      "autoPort": true
    },
    {
      "name": "zaro-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve@14",
        "out",
        "-n"
      ],
      "port": 3218,
      "autoPort": true
    },
    {
      "name": "zaro-minimal",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve@14",
        "v2-minimal/dist",
        "-n"
      ],
      "port": 3219,
      "autoPort": true
    },
    {
      "name": "zaro-minimal-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "v2-minimal",
        "run",
        "dev",
        "--",
        "--port",
        "4329"
      ],
      "port": 4329,
      "autoPort": true
    }
  ]
}
