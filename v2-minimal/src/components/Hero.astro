---
import { BUY, url } from "../lib/site";

const still = (s: string) => ({ d: url(`hero/${s}-d.webp`), m: url(`hero/${s}-m.webp`) });
const stills = { s0: still("s0"), s2: still("s2") };
---
<section class="hero dark" id="top" data-state="s0" aria-label="Zaro: know your blood">
  <div class="stage">
    <div class="media" aria-hidden="true">
      {Object.entries(stills).map(([k, v]) => (
        <picture class={`layer still ${k}`} data-layer={k}>
          <source media="(max-width: 820px)" srcset={v.m} />
          <img src={v.d} alt="" decoding="async" fetchpriority={k === "s0" ? "high" : "low"} />
        </picture>
      ))}
      <video class="layer" data-layer="t1" muted playsinline preload="none"></video>
      <video class="layer" data-layer="t2" muted playsinline preload="none"></video>
      <video class="layer" data-layer="t2r" muted playsinline preload="none"></video>
      <video class="layer" data-layer="t1r" muted playsinline preload="none"></video>
      <div class="glow"></div>
      <div class="fade"></div>
    </div>

    <div class="copy">
      <div class="beat beat-open" data-on="s0">
        <h1 class="h-display">Know your blood.</h1>
        <p class="lede">Every answer starts with a single drop.</p>
      </div>

      <div class="beat beat-bottom" data-on="t1">
        <p class="h-1">Over 100 markers.<br /><span class="dim">One draw.</span></p>
      </div>

      <div class="beat beat-bottom" data-on="t2">
        <p class="h-1">Zaro reads them all.<br /><span class="dim">And gives you one number.</span></p>
      </div>

      <div class="beat beat-score" data-on="s2">
        <p class="score">78</p>
        <p class="score-label">Your Zaro Score</p>
      </div>

      <div class="beat beat-cta" data-on="s2">
        <a href={BUY} class="btn btn-red">Find your test</a>
        <a href="#how" class="link">See how it works</a>
      </div>

      <a href="#gap" class="skip beat" data-on="s0 t1 t2">Skip intro</a>
      <p class="cue beat" data-on="s0" aria-hidden="true">Scroll</p>
    </div>
  </div>
</section>

<script>
  import { initHero } from "../scripts/hero";
  const el = document.querySelector<HTMLElement>(".hero");
  if (el) initHero(el);
</script>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    background: #000;
  }
  .stage {
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  /* Media layers: one visible at a time, crossfading. */
  .media {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .layer.on {
    opacity: 1;
  }
  .still img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Ambient life on the still scenes. */
  .s0 img {
    animation: float 7s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-1.2%) scale(1.012); }
  }
  /* Melt the footage into the next section's colour (black, brightening with its dawn), so they meet seamlessly. */
  .fade {
    --edge: color-mix(in srgb, var(--white) calc(var(--dawn, 0) * 100%), var(--black));
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in srgb, var(--edge) 35%, transparent) 45%,
      color-mix(in srgb, var(--edge) 80%, transparent) 78%,
      var(--edge)
    );
  }
  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 50% 47%, rgba(245, 245, 247, 0.12), transparent 26%);
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .hero[data-state="s2"] .glow {
    opacity: 1;
    animation: breathe 4.5s ease-in-out infinite;
  }
  .hero[data-state="s2"] .layer.on {
    animation: breathe-scale 9s ease-in-out infinite;
  }
  @keyframes breathe {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }
  @keyframes breathe-scale {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.018); }
  }

  /* Tall phones: keep the whole drop and ring in frame, fading the clip's edges into black. */
  @media (max-aspect-ratio: 4/5) {
    .layer {
      inset: auto;
      top: 50%;
      left: 50%;
      width: 230vw;
      height: auto;
      aspect-ratio: 16 / 9;
      translate: -50% -50%;
      -webkit-mask-image: linear-gradient(180deg, transparent, #000 22%, #000 78%, transparent);
      mask-image: linear-gradient(180deg, transparent, #000 22%, #000 78%, transparent);
    }
  }

  /* All the words, dissolving as the next section's dawn brightens the bottom of the hero. */
  .copy {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: calc(1 - var(--dawn, 0) * 1.6);
  }

  /* Text beats */
  /* Centred with auto margins (not translate: the CSS minifier drops translate next to transform). */
  .beat {
    position: absolute;
    left: 0;
    right: 0;
    width: min(100% - var(--gutter) * 2, 980px);
    margin: 0 auto;
    text-align: center;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s var(--ease), transform 0.9s var(--ease);
    pointer-events: none;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.55);
  }
  .beat.show {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .beat-open {
    bottom: clamp(64px, 11vh, 120px);
  }
  .beat-open .h-display {
    font-size: clamp(48px, 7.4vw, 104px);
  }
  .beat-open .lede {
    margin-top: 14px;
  }
  .beat-bottom {
    bottom: clamp(56px, 10vh, 104px);
  }
  .beat-bottom .h-1 {
    font-size: clamp(32px, 4.4vw, 60px);
  }
  .dim {
    color: #86868b;
  }
  .beat-score {
    top: 47%;
    translate: 0 -50%;
  }
  .score {
    margin: 0;
    font-size: clamp(64px, 9vw, 128px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .score-label {
    margin: 10px 0 0;
    font-size: 14px;
    color: #a1a1a6;
  }
  .beat-cta {
    bottom: clamp(48px, 10vh, 96px);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 28px;
  }

  .skip {
    left: auto;
    right: clamp(16px, 3vw, 36px);
    bottom: 24px;
    width: auto;
    margin: 0;
    font-size: 12px;
    color: #a1a1a6;
    text-shadow: none;
  }
  .skip:hover {
    color: #fff;
  }
  .cue {
    bottom: 24px;
    font-size: 12px;
    color: #86868b;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-shadow: none;
  }
</style>
