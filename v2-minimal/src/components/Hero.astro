---
const buy = "https://zarohealth.com/pricing";
const systems = ["Heart.", "Hormones.", "Metabolism.", "Thyroid.", "Nutrients."];
---
<section class="hero dark" id="top" aria-label="Zaro: know your blood">
  <div class="stage">
    <canvas class="canvas" aria-hidden="true"></canvas>

    <div class="beat beat-top" data-beat="0,0.16">
      <h1 class="h-display">Know your blood.</h1>
      <p class="lede">Every answer starts with a single drop.</p>
    </div>

    <div class="beat beat-center" data-beat="0.2,0.36">
      <p class="h-1">Over 100 markers.<br /><span class="dim">One draw.</span></p>
    </div>

    <ul class="beat beat-list" data-beat="0.42,0.66">
      {systems.map((s, i) => <li style={`--i:${i}`}>{s}</li>)}
    </ul>

    <div class="beat beat-bottom" data-beat="0.72,0.88">
      <p class="h-1">Zaro reads them all.<br /><span class="dim">And gives you one number.</span></p>
    </div>

    <div class="beat beat-score" data-beat="0.9,1">
      <p class="score mono">78</p>
      <p class="score-label">Your Zaro Score</p>
    </div>

    <div class="beat beat-cta" data-beat="0.9,1">
      <a href={buy} class="btn">Find your test</a>
      <a href="#how" class="link">See how it works</a>
    </div>

    <p class="cue beat" data-beat="0,0.06" aria-hidden="true">Scroll</p>
  </div>
</section>

<script>
  import { initHero } from "../scripts/hero";
  const el = document.querySelector<HTMLElement>(".hero");
  if (el) initHero(el);
</script>

<style>
  .hero {
    position: relative;
    height: 560vh;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .beat {
    position: absolute;
    left: 50%;
    width: min(100% - var(--gutter) * 2, 980px);
    margin: 0;
    translate: -50% 0;
    text-align: center;
    opacity: 0;
    will-change: opacity, transform;
  }
  .beat-top {
    top: clamp(84px, 13vh, 140px);
  }
  .beat-top .lede {
    margin-top: 18px;
  }
  .beat-bottom {
    bottom: clamp(48px, 9vh, 96px);
  }
  .beat-bottom .h-1 {
    font-size: clamp(32px, 4.4vw, 60px);
  }
  .beat-center {
    top: 50%;
    translate: -50% -50%;
  }
  .dim {
    color: #86868b;
  }
  .beat-list {
    top: 50%;
    translate: -50% -50%;
    list-style: none;
    padding: 0;
    text-align: left;
    font-size: clamp(40px, 6.4vw, 88px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }
  .beat-list li {
    color: #f5f5f7;
  }
  .beat-list li:nth-child(even) {
    color: #6e6e73;
  }
  .beat-score {
    top: 50%;
    translate: -50% -50%;
  }
  .score {
    margin: 0;
    font-size: clamp(64px, 9vw, 128px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .score-label {
    margin: 10px 0 0;
    font-size: 14px;
    color: #86868b;
  }
  .beat-cta {
    bottom: clamp(48px, 10vh, 96px);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 28px;
  }
  .cue {
    bottom: 32px;
    font-size: 12px;
    color: #86868b;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: 100svh;
    }
  }
</style>
