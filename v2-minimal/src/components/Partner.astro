---
import { RENA } from "../lib/rena";
import { url } from "../lib/site";
---
<section class="partner dark" aria-labelledby="partner-title">
  <div class="wrap">
    <a href={url("dr-rena-malik/")} class="band" data-reveal>
      <div class="photo">
        <img src={RENA.headshot} alt={`${RENA.name}, ${RENA.title}`} loading="lazy" />
      </div>
      <div class="copy">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span>New partnership</p>
        <h2 id="partner-title" class="h-1">Zaro ×<br /><span class="dim">Dr. Rena Malik.</span></h2>
        <p class="lede">The board-certified urologist behind 550M+ YouTube views is partnering with Zaro to make hormone and men’s health testing simple to understand.</p>
        <span class="link">Meet Dr. Malik</span>
      </div>
    </a>
  </div>
</section>

<style>
  .partner { padding-block: clamp(72px, 10vw, 140px); }
  .band { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .photo { border-radius: 28px; overflow: hidden; aspect-ratio: 4 / 5; background: #111; }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; filter: grayscale(1) contrast(1.06); transform: scale(1.02); transition: filter 1s var(--ease), transform 1.2s var(--ease); }
  .band:hover .photo img { filter: grayscale(0.1); transform: scale(1.05); }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--red); }
  .dim { color: #86868b; }
  .lede { margin-top: 24px; max-width: 30ch; }
  .link { margin-top: 32px; }
  @media (max-width: 760px) { .band { grid-template-columns: 1fr; } .photo { aspect-ratio: 4 / 4.2; } }
</style>
