---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  glyph: string;
  caption: string;
  topic: string;
  tone?: "black" | "paper" | "white";
  size?: "md" | "lg";
  class?: string;
  // Optional photo. Its tone replaces `tone` so the type stays legible on top of it.
  image?: ImageMetadata;
  imageTone?: "dark" | "light";
  focus?: string;
  sizes?: string;
  eager?: boolean;
}
const {
  glyph, caption, topic, tone = "black", size = "md", class: cls = "",
  image, imageTone = "dark", focus = "50% 50%", sizes = "(max-width: 860px) 100vw, 50vw", eager = false,
} = Astro.props;
const t = image ? (imageTone === "light" ? "paper" : "black") : tone;
---
<div class={`cover ${t} ${size} ${image ? "photo" : ""} ${cls}`} aria-hidden="true">
  {image ? (
    <Image
      src={image}
      alt=""
      widths={[640, 960, 1280, 1920, 2560]}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      class="img"
      style={`object-position: ${focus}`}
    />
  ) : (
    <>
      <span class="ring r1"></span>
      <span class="ring r2"></span>
    </>
  )}
  <span class="topic">{topic}</span>
  <span class="glyph">{glyph}</span>
  <span class="cap">{caption}</span>
</div>

<style>
  .cover {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(22px, 3vw, 36px);
    aspect-ratio: 16 / 10;
  }
  .black { background: #000; color: #f5f5f7; }
  .paper { background: var(--paper); color: var(--ink); }
  .white { background: #fff; color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
  .ring { position: absolute; border-radius: 50%; border: 1px solid color-mix(in srgb, currentColor 16%, transparent); }
  .r1 { width: 70%; aspect-ratio: 1; right: -18%; top: -38%; }
  .r2 { width: 40%; aspect-ratio: 1; right: -4%; top: -14%; }
  .r2::after {
    content: "";
    position: absolute;
    left: 6%;
    bottom: 12%;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--red);
  }
  .ring.r2 { border-color: color-mix(in srgb, currentColor 24%, transparent); }
  .img {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  /* Scrim under the type, bottom-left, so any photo keeps the glyph readable. */
  .photo::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.5), transparent 45%),
      linear-gradient(to right, rgb(0 0 0 / 0.35), transparent 55%);
  }
  .photo.paper::after {
    background:
      linear-gradient(to top, rgb(245 245 247 / 0.7), transparent 45%),
      linear-gradient(to right, rgb(245 245 247 / 0.5), transparent 55%);
  }
  .topic { position: absolute; top: clamp(20px, 2.6vw, 32px); left: clamp(22px, 3vw, 36px); font-size: 12px; font-weight: 600; opacity: 0.6; }
  .photo .topic, .photo .cap { opacity: 0.75; }
  .glyph {
    font-size: clamp(56px, 7vw, 96px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    transition: transform 0.8s var(--ease);
  }
  .lg .glyph { font-size: clamp(88px, 13vw, 180px); }
  .cap { margin-top: 10px; font-family: var(--mono); font-size: 12px; opacity: 0.6; }
  :global(a:hover) > .cover .glyph,
  :global(.card:hover) .cover .glyph { transform: translateY(-4px); }
  :global(a:hover) > .cover .img,
  :global(.card:hover) .cover .img { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .img { transition: none; }
  }
</style>
