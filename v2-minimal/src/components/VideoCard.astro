---
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<div class="video" data-video={id} data-title={title}>
  <button type="button" aria-label={`Play video: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" />
    <span class="shade"></span>
    <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
    <span class="t">{title}</span>
  </button>
</div>

<script>
  // Load YouTube only after a click: faster pages, no third-party cookies until the viewer opts in.
  document.querySelectorAll<HTMLElement>("[data-video]").forEach((el) => {
    el.querySelector("button")?.addEventListener("click", () => {
      const f = document.createElement("iframe");
      f.src = `https://www.youtube-nocookie.com/embed/${el.dataset.video}?autoplay=1&rel=0`;
      f.title = el.dataset.title ?? "Video";
      f.allow = "autoplay; encrypted-media; picture-in-picture";
      f.allowFullscreen = true;
      el.replaceChildren(f);
    });
  });
</script>

<style>
  .video { position: relative; aspect-ratio: 16 / 9; border-radius: 22px; overflow: hidden; background: #111; }
  .video :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  button { all: unset; cursor: pointer; position: absolute; inset: 0; }
  img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); transition: filter 0.6s var(--ease), transform 0.8s var(--ease); }
  button:hover img { filter: grayscale(0); transform: scale(1.03); }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,.8)); }
  .play { position: absolute; top: 50%; left: 50%; translate: -50% -50%; width: 56px; height: 56px; border-radius: 50%; background: rgba(255,255,255,.92); color: #000; display: grid; place-items: center; transition: transform .4s var(--ease); }
  .play svg { width: 22px; margin-left: 3px; }
  button:hover .play { transform: scale(1.08); }
  .t { position: absolute; left: 20px; right: 20px; bottom: 16px; color: #fff; font-size: 15px; font-weight: 600; line-height: 1.3; }
</style>
