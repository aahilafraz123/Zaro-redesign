---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cover from "../../components/Cover.astro";
import { fmtDate, url } from "../../lib/site";

const posts = (await getCollection("journal")).sort((a, b) => +b.data.date - +a.data.date);
const [lead, ...rest] = posts;
const topics = ["All", ...new Set(posts.map((p) => p.data.topic))];
const tones = ["paper", "black", "white", "black"] as const;
---
<Base title="Journal · Zaro" description="Practical, science-grounded guides on blood testing, biomarkers, and how to actually use your results.">
  <main>
    <section class="mast section-top" aria-labelledby="journal-title">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Journal</p>
        <h1 id="journal-title" class="h-display" data-reveal style="--d:.05s">Learn to read<br /><span class="muted">your own blood.</span></h1>
        <p class="lede intro" data-reveal style="--d:.1s">Practical, science-grounded guides on blood testing, biomarkers, and how to actually use your results.</p>
      </div>
    </section>

    <section class="lead" aria-label="Latest article">
      <div class="wrap">
        <a href={url(`journal/${lead.id}/`)} class="lead-card card" data-reveal>
          <Cover glyph={lead.data.glyph} caption={lead.data.caption} topic={lead.data.topic} size="lg" class="lead-cover" />
          <div class="lead-copy">
            <p class="meta">Latest · {fmtDate(lead.data.date)}</p>
            <h2 class="h-2">{lead.data.title}</h2>
            <p class="lede">{lead.data.excerpt}</p>
            <span class="link">Read the article</span>
          </div>
        </a>
      </div>
    </section>

    <section class="list section" aria-labelledby="all-title">
      <div class="wrap">
        <div class="list-head">
          <h2 id="all-title" class="h-2" data-reveal>Every guide.</h2>
          <div class="filters" role="group" aria-label="Filter by topic" data-reveal>
            {topics.map((t, i) => <button type="button" data-topic={t} aria-pressed={i === 0 ? "true" : "false"}>{t}</button>)}
          </div>
        </div>
        <ul class="grid">
          {rest.map((p, i) => (
            <li data-topic-item={p.data.topic}>
              <a href={url(`journal/${p.id}/`)} class="card" data-reveal style={`--d:${0.06 * i}s`}>
                <Cover glyph={p.data.glyph} caption={p.data.caption} topic={p.data.topic} tone={tones[i % tones.length]} />
                <p class="meta">{fmtDate(p.data.date)}</p>
                <h3 class="h-3">{p.data.title}</h3>
                <p class="ex">{p.data.excerpt}</p>
              </a>
            </li>
          ))}
          <li data-topic-item={lead.data.topic} class="lead-dup" hidden>
            <a href={url(`journal/${lead.id}/`)} class="card">
              <Cover glyph={lead.data.glyph} caption={lead.data.caption} topic={lead.data.topic} />
              <p class="meta">{fmtDate(lead.data.date)}</p>
              <h3 class="h-3">{lead.data.title}</h3>
              <p class="ex">{lead.data.excerpt}</p>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>
</Base>

<script>
  // Topic filter. "All" shows everything below the featured article; a topic shows every match, featured included.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-topic]")];
  const items = [...document.querySelectorAll<HTMLElement>("[data-topic-item]")];
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const t = b.dataset.topic!;
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      items.forEach((li) => {
        const dup = li.classList.contains("lead-dup");
        li.hidden = t === "All" ? dup : li.dataset.topicItem !== t;
        li.querySelector("[data-reveal]")?.classList.add("in");
      });
    }),
  );
</script>

<style>
  .section-top { padding: clamp(120px, 16vw, 200px) 0 clamp(48px, 6vw, 72px); background: #fff; }
  .muted { color: var(--mute); }
  .intro { margin-top: 28px; max-width: 34ch; }
  .lead { background: #fff; padding-bottom: clamp(56px, 8vw, 104px); }
  .lead-card { display: grid; grid-template-columns: 1.15fr 1fr; border-radius: 32px; overflow: hidden; background: var(--paper); }
  .lead-card :global(.lead-cover) { aspect-ratio: auto; min-height: 420px; }
  .lead-copy { padding: clamp(28px, 4vw, 56px); display: flex; flex-direction: column; justify-content: center; gap: 18px; }
  .lead-copy .h-2 { font-size: clamp(28px, 3vw, 40px); }
  .meta { margin: 0; font-size: 13px; color: var(--mute); font-weight: 500; }
  .list { background: var(--paper); }
  .list-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 24px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filters button {
    font: inherit; font-size: 14px; font-weight: 500; padding: 8px 16px; border-radius: 980px;
    border: 1px solid var(--line); background: #fff; color: var(--ink); cursor: pointer; transition: background .3s, color .3s;
  }
  .filters button[aria-pressed="true"] { background: var(--ink); color: #fff; border-color: var(--ink); }
  .grid { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .grid .card { display: flex; flex-direction: column; height: 100%; background: #fff; border-radius: 28px; overflow: hidden; padding-bottom: 28px; transition: transform .6s var(--ease), box-shadow .6s var(--ease); }
  .grid .card:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -40px rgba(0,0,0,.35); }
  .grid .meta, .grid .h-3, .grid .ex { padding-inline: 28px; }
  .grid .meta { margin-top: 24px; }
  .grid .h-3 { margin-top: 10px; }
  .ex { margin: 10px 0 0; color: var(--mute); font-size: 16px; }
  @media (max-width: 820px) {
    .lead-card { grid-template-columns: 1fr; }
    .lead-card :global(.lead-cover) { min-height: 260px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
