---
import "../styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Wordmark from "../components/Wordmark.astro";
import { url } from "../lib/site";

interface Props { title?: string; description?: string; image?: ImageMetadata; imageAlt?: string }
const {
  title = "Zaro — Know your blood.",
  description = "One blood draw. Over 100 markers. One number that tells you where you stand.",
  image,
  imageAlt,
} = Astro.props;
const og = image && (await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 85 }));
const ogUrl = og && new URL(og.src, Astro.site).href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const buy = "https://zarohealth.com/pricing";
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogUrl && (
      <>
        <meta property="og:image" content={ogUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="nav">
      <nav class="nav-inner wrap" aria-label="Main">
        <a href={base} class="nav-logo" aria-label="Zaro home"><Wordmark class="nav-mark" /></a>
        <ul class="nav-links">
          <li><a href={url("#how")}>How it works</a></li>
          <li><a href={url("#tests")}>Tests</a></li>
          <li><a href={url("journal/")} aria-current={path.startsWith(url("journal/")) ? "page" : undefined}>Journal</a></li>
          <li><a href={url("dr-rena-malik/")} aria-current={path.startsWith(url("dr-rena-malik/")) ? "page" : undefined}>Dr. Rena Malik</a></li>
        </ul>
        <a href={buy} class="nav-buy">Get started</a>
      </nav>
    </header>

    <slot />

    <footer class="foot">
      <div class="wrap">
        <p class="foot-note">
          Zaro is a direct-to-consumer blood testing service. Samples are processed at CLIA-certified Quest Diagnostics labs.
          Not available in New York, New Jersey or Rhode Island yet. Intro pricing through Nov 14, 2026.
        </p>
        <div class="foot-row">
          <p>© 2026 Zaro Health, Inc.</p>
          <ul>
            <li><a href="https://zarohealth.com/privacy">Privacy</a></li>
            <li><a href="https://zarohealth.com/terms">Terms</a></li>
            <li><a href={url("journal/")}>Journal</a></li>
            <li><a href={url("dr-rena-malik/")}>Dr. Rena Malik</a></li>
            <li><a href="https://zarohealth.com/faq">FAQ</a></li>
            <li><a href="https://zarohealth.com/contact">Contact</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script>
      import "../scripts/motion";
    </script>

    <style>
      .nav {
        position: fixed;
        inset: 0 0 auto;
        z-index: 50;
        height: 48px;
        background: rgba(0, 0, 0, 0.72);
        backdrop-filter: saturate(180%) blur(20px);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        color: #f5f5f7;
        transition: background 0.4s var(--ease), color 0.4s var(--ease);
      }
      :global(body.on-light) .nav {
        background: rgba(255, 255, 255, 0.72);
        color: var(--ink);
        box-shadow: 0 1px 0 var(--line);
      }
      .nav-inner {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }
      .nav-logo { display: flex; color: inherit; }
      .nav-logo :global(.nav-mark) { height: 15px; width: auto; }
      .nav-links {
        display: flex;
        gap: 32px;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 12px;
        letter-spacing: 0;
      }
      .nav-links a { opacity: 0.8; transition: opacity 0.2s; }
      .nav-links a[aria-current="page"] { opacity: 1; font-weight: 600; }
      .nav-links a:hover { opacity: 1; }
      .nav-buy {
        font-size: 12px;
        font-weight: 500;
        padding: 4px 12px;
        border-radius: 980px;
        background: var(--red);
        color: #fff;
        transition: background 0.4s var(--ease);
      }
      .nav-buy:hover { background: #96101f; }
      @media (max-width: 760px) {
        .nav-links { gap: 18px; }
        .nav-links li:nth-child(-n + 2) { display: none; }
      }

      .foot {
        background: var(--paper);
        color: var(--mute);
        font-size: 12px;
        padding: 28px 0 40px;
      }
      .foot-note {
        margin: 0 0 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--line);
        max-width: 72ch;
        line-height: 1.5;
      }
      .foot-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px;
      }
      .foot-row p { margin: 0; }
      .foot-row ul { display: flex; gap: 20px; list-style: none; margin: 0; padding: 0; }
      .foot-row a:hover { color: var(--ink); }
    </style>
  </body>
</html>
